pipeline {
    agent any
    
    environment {
        DOCKER_IMAGE = 'ml-model-api'
        DOCKER_TAG = "${BUILD_NUMBER}"
        REGISTRY_URL = 'your-registry.com'  // Replace with your Docker registry
        KUBECONFIG = credentials('kubeconfig')
        PYTHON_VERSION = '3.9'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_COMMIT = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
                    env.GIT_BRANCH = sh(returnStdout: true, script: 'git rev-parse --abbrev-ref HEAD').trim()
                }
            }
        }
        
        stage('Setup Environment') {
            steps {
                script {
                    // Create Python virtual environment
                    sh '''
                        python3 -m venv venv
                        . venv/bin/activate
                        pip install --upgrade pip
                        pip install -r requirements.txt
                    '''
                }
            }
        }
        
        stage('Code Quality Checks') {
            parallel {
                stage('Linting') {
                    steps {
                        sh '''
                            . venv/bin/activate
                            flake8 src/ --max-line-length=100
                            black --check src/
                        '''
                    }
                }
                
                stage('Type Checking') {
                    steps {
                        sh '''
                            . venv/bin/activate
                            mypy src/ --ignore-missing-imports
                        '''
                    }
                }
                
                stage('Security Scan') {
                    steps {
                        sh '''
                            . venv/bin/activate
                            bandit -r src/ -f json -o security-report.json || true
                        '''
                        archiveArtifacts artifacts: 'security-report.json', fingerprint: true
                    }
                }
            }
        }
        
        stage('Unit Tests') {
            steps {
                sh '''
                    . venv/bin/activate
                    pytest tests/ --junitxml=test-results.xml --cov=src --cov-report=xml --cov-report=html
                '''
                publishTestResults testResultsPattern: 'test-results.xml'
                publishCoverage adapters: [coberturaAdapter('coverage.xml')], sourceFileResolver: sourceFiles('STORE_LAST_BUILD')
            }
        }
        
        stage('Model Training & Validation') {
            steps {
                script {
                    sh '''
                        . venv/bin/activate
                        echo "Training model..."
                        python src/train_model.py
                        
                        echo "Validating model..."
                        python src/validate_model.py
                    '''
                    
                    // Archive model artifacts
                    archiveArtifacts artifacts: 'models/**/*', fingerprint: true
                }
            }
            post {
                always {
                    // Publish training logs
                    archiveArtifacts artifacts: '*.log', allowEmptyArchive: true
                }
            }
        }
        
        stage('Integration Tests') {
            steps {
                script {
                    // Start API server in background for testing
                    sh '''
                        . venv/bin/activate
                        python src/model_api.py &
                        API_PID=$!
                        echo $API_PID > api.pid
                        
                        # Wait for API to start
                        sleep 10
                        
                        # Run integration tests
                        pytest tests/test_integration.py --api-url=http://localhost:8000
                        
                        # Stop API server
                        kill $API_PID || true
                    '''
                }
            }
        }
        
        stage('Build Docker Image') {
            steps {
                script {
                    // Build Docker image
                    sh """
                        docker build -f docker/Dockerfile -t ${DOCKER_IMAGE}:${DOCKER_TAG} .
                        docker tag ${DOCKER_IMAGE}:${DOCKER_TAG} ${DOCKER_IMAGE}:latest
                    """
                }
            }
        }
        
        stage('Security Scan - Docker Image') {
            steps {
                script {
                    // Scan Docker image for vulnerabilities
                    sh """
                        docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \\
                            -v \$PWD:/tmp/.cache/ aquasec/trivy:latest \\
                            image --exit-code 0 --no-progress --format table \\
                            ${DOCKER_IMAGE}:${DOCKER_TAG}
                    """
                }
            }
        }
        
        stage('Deploy to Staging') {
            when {
                branch 'develop'
            }
            steps {
                script {
                    // Deploy to staging environment
                    sh """
                        # Push to registry
                        docker tag ${DOCKER_IMAGE}:${DOCKER_TAG} ${REGISTRY_URL}/${DOCKER_IMAGE}:staging-${DOCKER_TAG}
                        docker push ${REGISTRY_URL}/${DOCKER_IMAGE}:staging-${DOCKER_TAG}
                        
                        # Deploy to Kubernetes staging namespace
                        kubectl set image deployment/ml-api-staging ml-api=${REGISTRY_URL}/${DOCKER_IMAGE}:staging-${DOCKER_TAG} -n staging
                        kubectl rollout status deployment/ml-api-staging -n staging
                    """
                }
            }
        }
        
        stage('Staging Tests') {
            when {
                branch 'develop'
            }
            steps {
                script {
                    // Run tests against staging environment
                    sh '''
                        . venv/bin/activate
                        pytest tests/test_staging.py --staging-url=https://staging.yourapi.com
                    '''
                }
            }
        }
        
        stage('Deploy to Production') {
            when {
                branch 'main'
            }
            steps {
                script {
                    // Manual approval for production deployment
                    input message: 'Deploy to Production?', ok: 'Deploy',
                          submitterParameter: 'DEPLOYER'
                    
                    // Deploy to production
                    sh """
                        # Tag for production
                        docker tag ${DOCKER_IMAGE}:${DOCKER_TAG} ${REGISTRY_URL}/${DOCKER_IMAGE}:prod-${DOCKER_TAG}
                        docker tag ${DOCKER_IMAGE}:${DOCKER_TAG} ${REGISTRY_URL}/${DOCKER_IMAGE}:prod-latest
                        
                        # Push to registry
                        docker push ${REGISTRY_URL}/${DOCKER_IMAGE}:prod-${DOCKER_TAG}
                        docker push ${REGISTRY_URL}/${DOCKER_IMAGE}:prod-latest
                        
                        # Blue-green deployment to production
                        kubectl set image deployment/ml-api-prod ml-api=${REGISTRY_URL}/${DOCKER_IMAGE}:prod-${DOCKER_TAG} -n production
                        kubectl rollout status deployment/ml-api-prod -n production
                    """
                }
            }
        }
        
        stage('Production Smoke Tests') {
            when {
                branch 'main'
            }
            steps {
                script {
                    // Run smoke tests against production
                    sh '''
                        . venv/bin/activate
                        pytest tests/test_smoke.py --prod-url=https://api.yourapi.com
                    '''
                }
            }
        }
        
        stage('Performance Tests') {
            when {
                branch 'main'
            }
            steps {
                script {
                    // Run performance/load tests
                    sh '''
                        . venv/bin/activate
                        locust -f tests/load_test.py --headless -u 50 -r 10 -t 300s --host=https://api.yourapi.com
                    '''
                }
            }
        }
    }
    
    post {
        always {
            // Clean up
            sh '''
                docker system prune -f
                rm -f api.pid
            '''
            
            // Archive logs and reports
            archiveArtifacts artifacts: '**/*.log', allowEmptyArchive: true
            
            // Publish test results
            publishTestResults testResultsPattern: '**/test-results.xml'
        }
        
        success {
            // Notify success
            emailext (
                subject: "✅ ML Model Pipeline Success - Build #${BUILD_NUMBER}",
                body: """
                Build #${BUILD_NUMBER} completed successfully!
                
                Branch: ${GIT_BRANCH}
                Commit: ${GIT_COMMIT}
                
                View build: ${BUILD_URL}
                """,
                to: "${env.CHANGE_AUTHOR_EMAIL ?: 'team@company.com'}"
            )
        }
        
        failure {
            // Notify failure
            emailext (
                subject: "❌ ML Model Pipeline Failed - Build #${BUILD_NUMBER}",
                body: """
                Build #${BUILD_NUMBER} failed!
                
                Branch: ${GIT_BRANCH}
                Commit: ${GIT_COMMIT}
                
                View build: ${BUILD_URL}
                Console: ${BUILD_URL}console
                """,
                to: "${env.CHANGE_AUTHOR_EMAIL ?: 'team@company.com'}"
            )
        }
        
        unstable {
            // Notify unstable build
            emailext (
                subject: "⚠️ ML Model Pipeline Unstable - Build #${BUILD_NUMBER}",
                body: """
                Build #${BUILD_NUMBER} is unstable (tests failed but build succeeded).
                
                Branch: ${GIT_BRANCH}
                Commit: ${GIT_COMMIT}
                
                View build: ${BUILD_URL}
                """,
                to: "${env.CHANGE_AUTHOR_EMAIL ?: 'team@company.com'}"
            )
        }
    }
}
